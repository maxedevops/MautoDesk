# MautoDesk — local development environment.
#
# Copy to `.env`. The .env file is gitignored and must never be committed.
# Every value here is a localhost-only development credential. Production
# secrets live in DigitalOcean app secrets and the encrypted credential store —
# never in a file, never in this repository.

# --- Database -----------------------------------------------------------------
# The application connects as mautodesk_app, which has NO BYPASSRLS and is not
# the table owner. This is load-bearing: see ADR-0002.
DATABASE_URL=Host=localhost;Port=5432;Database=mautodesk;Username=mautodesk_app;Password=devpw
# Migrations run as a different, higher-privileged role.
DATABASE_MIGRATION_URL=Host=localhost;Port=5432;Database=mautodesk;Username=postgres;Password=devpw

# --- Cache --------------------------------------------------------------------
REDIS_URL=localhost:6379

# --- Trusted proxies ----------------------------------------------------------
# Who may assert a client address. A forwarded header is believed ONLY from a
# peer in this list; from anyone else the socket address is used. This is what
# makes the per-IP auth limit work behind a reverse proxy without letting an
# attacker choose their own rate-limit bucket by setting a header.
#
# The default covers loopback and the private ranges, which is right for a
# reverse proxy on the same host or container network. BEHIND CLOUDFLARE YOU
# MUST ADD ITS RANGES (https://www.cloudflare.com/ips/) — they are public
# addresses and are not trusted by default. Leave the list empty for an origin
# with nothing in front of it.
Network__TrustedProxies__0=127.0.0.1/32
Network__TrustedProxies__1=::1/128
Network__TrustedProxies__2=172.16.0.0/12

# --- Object storage (MinIO locally, Cloudflare R2 in every deployed env) -------
# Double underscores because these bind to the Storage configuration section
# the API reads; a single underscore is not the same key.
Storage__ServiceUrl=http://localhost:9000
# The endpoint presigned URLs are signed for, when it differs from the one this
# process uses. A presigned URL is handed to a browser and its signature covers
# the host in it, so behind a proxy the two are not the same address. Leave
# empty when storage is directly reachable by both.
Storage__PublicUrl=
Storage__AccessKey=mautodesk
Storage__SecretKey=devpassword
Storage__ForcePathStyle=true
Storage__QuarantineBucket=mautodesk-uploads
Storage__MediaBucket=mautodesk-media
Storage__DocumentsBucket=mautodesk-docs
Storage__VaultBucket=mautodesk-vault
# The origin photos are served from. Named in the frontend's CSP, because
# ADR-0005 forbids serving uploads from the application origin.
MEDIA_ORIGIN=http://localhost:9000

# --- Encryption ---------------------------------------------------------------
# Envelope-encryption master key (ADR-0007). In production this is a DigitalOcean
# app secret, rotated on a documented schedule. RISK-SEC-001 tracks the absence
# of a hardware-backed KMS on DigitalOcean.
# Generate a dev key: openssl rand -base64 32
ENCRYPTION_MASTER_KEY=REPLACE_ME_WITH_A_32_BYTE_BASE64_KEY
ENCRYPTION_MASTER_KID=dev-1
# Separate key for blind indexes (searchable encrypted fields). Must NOT equal
# the master key — a single key doing both jobs weakens both.
BLIND_INDEX_KEY=REPLACE_ME_WITH_A_32_BYTE_BASE64_KEY

# --- Authentication -----------------------------------------------------------
JWT_ISSUER=https://localhost:5080
JWT_AUDIENCE=mautodesk-api
JWT_SIGNING_KEY=REPLACE_ME_WITH_A_32_BYTE_BASE64_KEY
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30

# --- Email / SMS --------------------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@mautodesk.local
# Twilio A2P 10DLC registration is required per tenant before any production SMS.
# Leave blank locally; the messaging module logs instead of sending.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# --- AI -----------------------------------------------------------------------
# Per-tenant quotas are enforced before every call. Leave blank to run with the
# AI features disabled rather than erroring.
ANTHROPIC_API_KEY=
AI_MODEL_BULK=claude-sonnet-5
AI_MODEL_EXTRACTION=claude-opus-5
AI_MONTHLY_COST_CAP_USD=50

# --- Integrations -------------------------------------------------------------
# NHTSA vPIC needs no key. Trim data is often absent; treat missing as unknown.
VIN_DECODER_PROVIDER=nhtsa_vpic
VIN_DECODER_BASE_URL=https://vpic.nhtsa.dot.gov/api

# --- Upload scanning ----------------------------------------------------------
MalwareScanning__Host=localhost
MalwareScanning__Port=3310
# Fail closed: with this true, an upload is refused when clamd is unreachable
# rather than promoted unscanned. Set it to false only on a machine where that
# is genuinely acceptable — a developer laptop with no clamav container.
MalwareScanning__Required=true

# --- Observability ------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=
SENTRY_DSN=
LOG_LEVEL=Information

# --- Frontend -----------------------------------------------------------------
NEXT_PUBLIC_APP_NAME=MautoDesk
API_BASE_URL=http://localhost:5080/api/v1
# The BFF session cookie key. The browser never receives a JWT (ADR §4).
SESSION_SECRET=REPLACE_ME_WITH_A_32_BYTE_BASE64_KEY

# --- Local host ports ---------------------------------------------------------
# Change these if another project on your machine already owns the default port.
# Only the host side moves; container-to-container addresses are unaffected.
POSTGRES_PORT=5432
VALKEY_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
CLAMAV_PORT=3310
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
