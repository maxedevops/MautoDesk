{
  "name": "@mautodesk/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "generate": "openapi-typescript ../../../contracts/openapi.json -o ./src/schema.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "echo \"no lint config yet\"",
    "test": "vitest run"
  },
  "devDependencies": {
    "openapi-typescript": "7.9.1",
    "vitest": "3.2.6",
    "typescript": "5.9.2"
  }
}
