{
  "name": "mautodesk-frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @mautodesk/web dev",
    "build": "pnpm --filter @mautodesk/api-client build && pnpm --filter @mautodesk/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm --filter @mautodesk/api-client build && pnpm -r typecheck",
    "test": "pnpm -r test",
    "generate:client": "pnpm --filter @mautodesk/api-client generate"
  },
  "devDependencies": {
    "typescript": "5.9.2",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "pnpm": {
    "overrides": {
      "postcss": ">=8.5.18 <9",
      "sharp": ">=0.35.5 <0.36",
      "brace-expansion": ">=2.1.7 <3",
      "js-yaml": ">=4.3.2 <5",
      "minimatch": ">=11.0.1 <12",
      "nanoid": ">=3.3.18 <4",
      "source-map-js": ">=1.2.2 <2",
      "vite": ">=7.3.7 <8"
    }
  },
  "packageManager": "pnpm@10.28.0"
}
