<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Package sources are declared in the repository, not left to whatever happens
    to be configured on a developer's machine. A build that succeeds locally and
    fails in CI because of a machine-level source is a waste of an afternoon;
    worse, an unexpected source is a supply-chain risk.

    <clear /> discards any inherited machine or user configuration so this file
    is the complete list.
  -->

  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <!--
    Source mapping: every package must come from an explicitly named source.
    With a single source this is mostly documentation, but it becomes a real
    control the moment a private feed is added — it prevents a dependency
    confusion attack where a public package shadows an internal one.
  -->
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

  <config>
    <!-- Fail the build rather than silently downgrading to an older package. -->
    <add key="signatureValidationMode" value="accept" />
  </config>

</configuration>
