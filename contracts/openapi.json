{
  "openapi": "3.0.1",
  "info": {
    "title": "MautoDesk API",
    "description": "Multi-tenant dealership management platform.\n\n**Authentication.** Bearer access tokens. Tenant scope is carried in the token's `tenant` claim; supplying a tenant identifier in a header, query string, or body has no effect and is never honoured.\n\n**Errors.** All non-2xx responses are RFC 9457 `application/problem+json`. A resource belonging to another tenant is reported as `404 Not Found` — the API does not confirm the existence of records outside the caller's tenant.\n\n**Money** is transported as a decimal string (`\"28995.00\"`), never a JSON number, so no client can round it through a floating-point value.",
    "license": {
      "name": "Proprietary",
      "url": "https://mautodesk.com/legal/api-terms"
    },
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "https://api.mautodesk.com",
      "description": "Production"
    },
    {
      "url": "https://staging-api.mautodesk.com",
      "description": "Staging"
    },
    {
      "url": "http://localhost:5080",
      "description": "Local development"
    }
  ],
  "paths": {
    "/api/v1/vin/{vin}/decode": {
      "get": {
        "tags": [
          "Inventory"
        ],
        "summary": "Decode a VIN",
        "operationId": "decodeVin",
        "parameters": [
          {
            "name": "vin",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "boolean",
              "default": false
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VinDecodeDto"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or invalid credentials.",
            "content": {
              "application/problem+json": { }
            }
          },
          "403": {
            "description": "The principal lacks the required permission.",
            "content": {
              "application/problem+json": { }
            }
          },
          "404": {
            "description": "Not found, or the resource belongs to another tenant. These cases are deliberately indistinguishable: a 403 would confirm the record exists.",
            "content": {
              "application/problem+json": { }
            }
          }
        },
        "x-permission": "inventory.vehicle.read"
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "Authentication"
        ],
        "summary": "Authenticate with email and password",
        "description": "Returns tokens only when no second factor is outstanding. Because MFA is mandatory, the normal responses are mfaRequired or mfaEnrolmentRequired. The response for an unknown address is identical to the response for a wrong password, and the timing is equalised, so this endpoint cannot be used to discover which addresses have accounts.",
        "operationId": "login",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                }
              }
            }
          },
          "403": {
            "description": "Forbidden",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "429": {
            "description": "Too Many Requests",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, or invalid credentials.",
            "content": {
              "application/problem+json": { }
            }
          }
        }
      }
    },
