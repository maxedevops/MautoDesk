  "components": {
    "schemas": {
      "AuthResponse": {
        "required": [
          "outcome",
          "tokens",
          "challengeToken",
          "enrolmentSecret",
          "enrolmentUri",
          "recoveryCodes"
        ],
        "type": "object",
        "properties": {
          "outcome": {
            "type": "string"
          },
          "tokens": {
            "$ref": "#/components/schemas/TokenPair"
          },
          "challengeToken": {
            "type": "string",
            "nullable": true
          },
          "enrolmentSecret": {
            "type": "string",
            "nullable": true
          },
          "enrolmentUri": {
            "type": "string",
            "nullable": true
          },
          "recoveryCodes": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "nullable": true
          }
        }
      },
      "ChangePriceRequest": {
