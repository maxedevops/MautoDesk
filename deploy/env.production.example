# Copy to .env.production at the repository root and fill in. That filename is
# git-ignored; this template is not, so nothing real belongs in this file.
#
#   cp deploy/env.production.example .env.production
#
# Generate every secret below with:
#
#   openssl rand -base64 32
#
# Each must decode to exactly 32 bytes. The application refuses to start on a
# short key rather than padding one, because a key that "works" and is weak is
# worse than a startup failure.

# --- Names --------------------------------------------------------------------
# Both must already resolve to this host, or ACME cannot issue certificates.
APP_DOMAIN=app.example.com
MEDIA_DOMAIN=media.example.com
ACME_EMAIL=ops@example.com

# --- Images -------------------------------------------------------------------
# Left as-is, compose builds locally. Point IMAGE_PREFIX at a registry to build
# elsewhere and pull — worth doing, because building the two images on a 4 GB
# VPS while ClamAV holds 2 GB of it is unpleasant.
IMAGE_PREFIX=mautodesk
IMAGE_TAG=latest

# --- Secrets ------------------------------------------------------------------
# Sessions: seals the BFF cookie holding the access and refresh tokens.
# Rotating this signs everyone out, which is the correct behaviour.
SESSION_SECRET=

# Signs access tokens. Rotating invalidates every issued token.
JWT_SIGNING_KEY=

# Envelope-encryption master key: the TOTP secrets and every encrypted column
# are unrecoverable without it. Back it up somewhere that is not this machine.
# RISK-SEC-001 tracks the absence of a hardware-backed KMS.
ENCRYPTION_MASTER_KEY=
ENCRYPTION_KEY_ID=prod-1

# --- Database -----------------------------------------------------------------
# The superuser password is used by the migration job only. The application
# connects as mautodesk_app, which has no BYPASSRLS and does not own the tables
# — that is what makes a data-layer bug return zero rows instead of another
# dealership's customers.
POSTGRES_SUPERUSER_PASSWORD=
APP_DB_PASSWORD=

# --- Object storage -----------------------------------------------------------
# MinIO's root credentials, which the API uses to sign upload and download URLs.
MINIO_ROOT_USER=mautodesk
MINIO_ROOT_PASSWORD=
