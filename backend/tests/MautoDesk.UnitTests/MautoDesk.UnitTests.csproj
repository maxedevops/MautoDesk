<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Modules\Inventory\MautoDesk.Inventory.Application\MautoDesk.Inventory.Application.csproj" />
    <ProjectReference Include="..\..\src\Modules\Identity\MautoDesk.Identity.Infrastructure\MautoDesk.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Modules\Inventory\MautoDesk.Inventory.Infrastructure\MautoDesk.Inventory.Infrastructure.csproj" />
    <!-- The log-redaction policy lives in the host, because it is wired into
         the host's logging pipeline. -->
    <ProjectReference Include="..\..\src\MautoDesk.Api\MautoDesk.Api.csproj" />
    <!-- The two deterministic engines. Pure, so they need nothing but a
         reference: no database, no host, no fixture. -->
    <ProjectReference Include="..\..\src\Modules\Sales\MautoDesk.Sales.Domain\MautoDesk.Sales.Domain.csproj" />
    <ProjectReference Include="..\..\src\Modules\Compliance\MautoDesk.Compliance.Domain\MautoDesk.Compliance.Domain.csproj" />
    <!-- The approval preconditions. The tool is an executable, but what is
         worth testing in it is a pure function of a draft, its corpus and the
         dates being requested — no database, no console. -->
    <ProjectReference Include="..\..\src\Modules\Compliance\MautoDesk.Compliance.RuleKeeper\MautoDesk.Compliance.RuleKeeper.csproj" />
    <!-- The same, for a tax rule set. Its checks run the real DealEngine over a
         $20,000 deal, so what is under test is whether the rule set would
         actually price one - not whether it looks plausible. -->
    <ProjectReference Include="..\..\src\Modules\Sales\MautoDesk.Sales.TaxKeeper\MautoDesk.Sales.TaxKeeper.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
  </ItemGroup>

</Project>
